{
  "name": "dsh-multeam",
  "version": "0.2.0",
  "description": "Multeam — DeepSeek Harness multi-agent team plugin: roster, durable mailbox, shared task DAG, scoped tools, ready-task scheduler, and a web team board",
  "type": "module",
  "license": "MIT",
  "author": "fenda1-1",
  "homepage": "https://github.com/fenda1-1/dsh-multeam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenda1-1/dsh-multeam.git"
  },
  "icon": "./icon.svg",
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "agent-teams",
    "multi-agent",
    "cordis"
  ],
  "files": [
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index.d.ts",
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "check": "npm run build && node --check dist/index.js && node --check dist/client.js && npm test",
    "test": "node --test \"test/*.test.js\" && node test/client-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-*": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-group": "^1.0.5",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.7",
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-file-upload": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-cmdline": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-image-offload": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-config-editor": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-file-reference": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-hmr": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-http-proxy": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-native-command": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-package-manifest": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-permission-presets": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-catalog": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection-cache": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session-title": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-todo": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-time": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-util-workspace-path": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  }
}
